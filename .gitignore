# Datasets run to hundreds of megabytes and weights are binaries; both are
# reproducible from the capture plus this code, so neither belongs in git.
datasets/
work/
*.pt
*.onnx
*.engine

# Exception: the shipped gate-pose model. "Reproducible from the capture plus
# this code" is true of a checkpoint and not true of this one -- the capture is
# hundreds of megabytes outside every repo and the annotations are a Roboflow
# export, so rebuilding it means re-downloading both and re-running a GPU.
# 18 MB per pair is the cheaper side of that trade.
!models/gate_pose_hand*.onnx
!models/gate_pose_hand*.pt
*.npy
__pycache__/
*.py[cod]
.venv/
venv/
.DS_Store
